# /etc/nativa-respaldo/respaldo.env  (modo 600, dueño nativa-respaldo). ESTE ES UN EJEMPLO: sin valores reales.
# NUNCA se pone aquí NATIVA_ADMIN_TOKEN ni NATIVA_SESION_CLAVE, ni la clave maestra age.
NATIVA_DATOS=/var/lib/nativa
NATIVA_CODIGO=/opt/nativa
NATIVA_RESPALDO_DESTINO=b2
# Claves PÚBLICAS age (empiezan con age1…): la maestra (guardada fuera de GitHub y de Oracle) y la de reserva
NATIVA_RESPALDO_DESTINATARIOS=age1_PUBLICA_MAESTRA,age1_PUBLICA_RESERVA
# Clave PÚBLICA del verificador (sólo cifra el canario)
NATIVA_RESPALDO_VERIFICADOR=age1_PUBLICA_VERIFICADOR
# Clave de aplicación de B2 de SÓLO ESCRITURA (writeFiles), limitada a los tres buckets
B2_ID_ESCRITURA=
B2_CLAVE_ESCRITURA=
B2_CUBO_SEIS_HORAS=nativa-seis-horas
B2_CUBO_DIARIO=nativa-diario
B2_CUBO_SEMANAL=nativa-semanal
# Avisos (opcionales). Ejemplo: un tema de ntfy.sh. La alerta que NO depende de esta máquina es vigilar.js en GitHub Actions
NATIVA_ALERTA_URL=
NATIVA_LATIDO_URL=
